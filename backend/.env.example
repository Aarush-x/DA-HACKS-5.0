# ShelfSense backend configuration (copy to .env for local dev)

# Catalog source: "seed" (committed JSON) or "postgres" (optional, not yet implemented)
CATALOG_STORAGE=seed

# Label surfaced in catalog metadata so integration can tell which dataset is live
CATALOG_VERSION=seed-dev-1

# Exact allowed browser origins, as a JSON array. Add the real Vercel origin later.
CORS_ORIGINS=["http://localhost:5173"]

# Only used when CATALOG_STORAGE=postgres. Never commit a real value.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
